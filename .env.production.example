# ============================================================
# GitHub Stars — 生产环境环境变量模板
# ============================================================
# 使用方式:
#   cp .env.production.example .env.production
#   然后填写下面的配置项
# ============================================================

# ─── 数据库配置 ─────────────────────────────────────────────
# MySQL root 密码（必须设置）
MYSQL_ROOT_PASSWORD=your_secure_password_here

# 数据库名称
MYSQL_DATABASE=githubstars

# 后端连接数据库的 URL（容器内通过服务名 mysql 访问）
DATABASE_URL=mysql://root:your_secure_password_here@mysql:3306/githubstars?charset=utf8mb4

# ─── 端口配置 ───────────────────────────────────────────────
# 前端 Nginx 端口（宿主机）
HTTP_PORT=10003

# 后端调试端口（宿主机，可选，用于直接访问后端 API）
BACKEND_DEBUG_PORT=10004

# ─── CORS 配置 ─────────────────────────────────────────────
# 允许的前端源（逗号分隔）
CORS_ORIGINS=http://localhost:10003

# ─── 数据目录配置 ───────────────────────────────────────────
# 克隆文件存储目录（宿主机路径，相对或绝对路径均可）
# Windows 示例: D:/githubstars-data/clones
# Linux 示例:   /data/githubstars/clones
CLONE_DATA_DIR=./data/clones

# 下载文件存储目录（宿主机路径）
DOWNLOAD_DATA_DIR=./data/downloads

# 日志存储目录（宿主机路径）
LOG_DATA_DIR=./data/logs
