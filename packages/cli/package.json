{
  "name": "@githubstars/cli",
  "version": "1.0.0",
  "description": "GitHub Stars CLI — 完整的命令行管理工具",
  "type": "module",
  "bin": {
    "githubstars": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "registry": "http://localhost:4873/"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "chalk": "^5.4.1",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
