generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model GithubRepo {
  id              Int    @id @default(autoincrement())
  repoName        String?   @map("repo_name") 
  fullName        String?   @unique @map("full_name") 
  description     String?   @map("description") 
  descriptionCn   String?   @map("description_cn") 
  readmeCn        String?   @map("readme_cn") 
  readmeOriginal  String?   @map("readme_original") 
  readmeFetched   Boolean   @default(false) @map("readme_fetched") 
  language        String?   @map("language") 
  ownerName       String?   @map("owner_name") 
  ownerAvatarUrl  String?   @map("owner_avatar_url") 
  htmlUrl         String?   @map("html_url") 
  homepage        String?   @map("homepage") 
  starsCount      Int       @default(0) @map("stars_count")
  forksCount      Int       @default(0) @map("forks_count")
  watchersCount   Int       @default(0) @map("watchers_count")
  openIssuesCount Int       @default(0) @map("open_issues_count")
  topics          String?   @map("topics") 
  licenseName     String?   @map("license_name") 
  isFork          Boolean   @default(false) @map("is_fork") 
  isArchived      Boolean   @default(false) @map("is_archived")
  repoSize        Int?      @map("repo_size")
  defaultBranch   String?   @map("default_branch")
  visibility      String?   @map("visibility")
  repoCreatedAt   DateTime? @map("repo_created_at")
  repoUpdatedAt   DateTime? @map("repo_updated_at") 
  repoPushedAt    DateTime? @map("repo_pushed_at") 
  starredAt       DateTime? @map("starred_at") 
  createdAt       DateTime  @map("created_at") 
  updatedAt       DateTime  @updatedAt @map("updated_at") 

  // 关联
  cloneItems       CloneTaskItem[]
  downloadItems    DownloadTaskItem[]
  categories       CategoryRepoLink[]
  learnRecord      LearnRecord?

  @@index([language])
  @@index([ownerName])
  @@index([starredAt])
  @@index([starsCount])
  @@index([repoUpdatedAt])
  @@map("github_repo")
}

// ── 分类管理 ──

/**
 * 分类表 —— 两级分类自引用结构。
 *
 * 一级分类 parentId = null，二级分类 parentId 指向一级分类的 id。
 * 使用 onDelete: Cascade 确保删除父分类时自动删除所有子分类。
 */
model Category {
  id          Int      @id @default(autoincrement())
  name        String   @map("name")
  parentId    Int?     @map("parent_id")
  sortOrder   Int      @default(0) @map("sort_order")
  icon        String?  @map("icon") 
  description String?  @map("description") 
  createdAt   DateTime @map("created_at") 
  updatedAt   DateTime @updatedAt @map("updated_at") 

  parent            Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          Category[]         @relation("CategoryTree")
  categoryRepoLinks CategoryRepoLink[]
  myRepoLinks       MyRepoCategoryLink[]

  @@index([parentId])
  @@index([sortOrder])
  @@map("category")
}

/**
 * 分类-仓库关联中间表 —— 多对多关系。
 *
 * 一个仓库可属于多个分类，一个分类可包含多个仓库。
 * @@unique([categoryId, repoId]) 防止重复关联。
 */
model CategoryRepoLink {
  id         Int  @id @default(autoincrement())
  categoryId Int @map("category_id")
  repoId     Int  @map("repo_id")
  createdAt  DateTime @map("created_at") 

  category Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  repo     GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([categoryId, repoId])
  @@index([repoId])
  @@map("category_repo_link")
}

// ── 我的仓库 ──

/**
 * 我的仓库表 —— 用户自己在 GitHub 上创建的仓库（含私有）。
 * 与 github_repo（Star 收藏）独立建表，无 starredAt，多 isPrivate。
 */
model MyRepo {
  id              Int    @id @default(autoincrement())
  repoName        String?   @map("repo_name")
  fullName        String?   @unique @map("full_name")
  description     String?   @map("description")
  descriptionCn   String?   @map("description_cn")
  readmeCn        String?   @map("readme_cn")
  readmeOriginal  String?   @map("readme_original")
  readmeFetched   Boolean   @default(false) @map("readme_fetched")
  language        String?   @map("language")
  ownerName       String?   @map("owner_name")
  ownerAvatarUrl  String?   @map("owner_avatar_url")
  htmlUrl         String?   @map("html_url")
  homepage        String?   @map("homepage")
  starsCount      Int       @default(0) @map("stars_count")
  forksCount      Int       @default(0) @map("forks_count")
  watchersCount   Int       @default(0) @map("watchers_count")
  openIssuesCount Int       @default(0) @map("open_issues_count")
  topics          String?   @map("topics")
  licenseName     String?   @map("license_name")
  isFork          Boolean   @default(false) @map("is_fork")
  isArchived      Boolean   @default(false) @map("is_archived")
  isPrivate       Boolean   @default(false) @map("is_private")
  repoSize        Int?      @map("repo_size")
  defaultBranch   String?   @map("default_branch")
  visibility      String?   @map("visibility")
  repoCreatedAt   DateTime? @map("repo_created_at")
  repoUpdatedAt   DateTime? @map("repo_updated_at")
  repoPushedAt    DateTime? @map("repo_pushed_at")
  createdAt       DateTime  @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // 关联
  cloneItems    MyRepoCloneTaskItem[]
  downloadItems MyRepoDownloadTaskItem[]
  categories    MyRepoCategoryLink[]

  @@index([language])
  @@index([starsCount])
  @@index([repoUpdatedAt])
  @@index([isPrivate])
  @@map("my_repo")
}

/**
 * 我的仓库-分类关联表 —— 多对多关系，复用 category 分类树。
 */
model MyRepoCategoryLink {
  id         Int   @id @default(autoincrement())
  categoryId Int   @map("category_id")
  myRepoId   Int   @map("my_repo_id")
  createdAt  DateTime @map("created_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  myRepo   MyRepo   @relation(fields: [myRepoId], references: [id], onDelete: Cascade)

  @@unique([categoryId, myRepoId])
  @@index([myRepoId])
  @@map("my_repo_category_link")
}

model SyncLog {
  id           Int    @id @default(autoincrement())
  syncType     String?   @map("sync_type") 
  status       String?   @map("status") 
  totalCount   Int?      @map("total_count")
  syncedCount  Int?      @map("synced_count")
  startedAt    DateTime? @map("started_at") 
  finishedAt   DateTime? @map("finished_at") 
  errorMessage String?   @map("error_message") 
  createdAt    DateTime? @map("created_at") 

  @@index([status])
  @@index([createdAt])
  @@map("sync_log")
}

model SystemConfig {
  id          Int    @id @default(autoincrement())
  configKey   String    @unique @map("config_key") 
  configValue String?   @map("config_value") 
  description String?   @map("description") 
  createdAt   DateTime? @map("created_at") 
  updatedAt   DateTime? @map("updated_at") 

  @@map("system_config")
}

model CloneTask {
  id             Int    @id @default(autoincrement())
  status         String?   @default("PENDING") @map("status") 
  targetDir      String    @map("target_dir") 
  concurrency    Int       @default(5) @map("concurrency")
  shallow        Boolean   @default(true) @map("shallow") 
  mirrorSource   String?   @default("direct") @map("mirror_source") 
  totalItems     Int       @default(0) @map("total_items")
  completedItems Int       @default(0) @map("completed_items")
  failedItems    Int       @default(0) @map("failed_items")
  skippedItems   Int       @default(0) @map("skipped_items")
  createdAt      DateTime? @map("created_at") 
  startedAt      DateTime? @map("started_at") 
  finishedAt     DateTime? @map("finished_at") 

  items       CloneTaskItem[]
  myRepoItems MyRepoCloneTaskItem[]

  @@index([status])
  @@index([createdAt])
  @@map("clone_task")
}

model CloneTaskItem {
  id           Int    @id @default(autoincrement())
  taskId       Int    @map("task_id")
  repoId       Int    @map("repo_id")
  fullName     String?   @map("full_name") 
  cloneUrl     String?   @map("clone_url") 
  localPath    String?   @map("local_path") 
  status       String?   @default("PENDING") @map("status") 
  retryCount   Int       @default(0) @map("retry_count")
  errorMessage String?   @map("error_message") 
  createdAt    DateTime? @map("created_at") 
  updatedAt    DateTime? @updatedAt @map("updated_at") 

  task CloneTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repo GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([repoId])
  @@index([status])
  @@map("clone_task_item")
}

/**
 * 我的仓库克隆任务子项 —— 与 clone_task_item 平行，repoId 指向 my_repo。
 */
model MyRepoCloneTaskItem {
  id           Int    @id @default(autoincrement())
  taskId       Int    @map("task_id")
  repoId       Int    @map("repo_id")
  fullName     String?   @map("full_name")
  cloneUrl     String?   @map("clone_url")
  localPath    String?   @map("local_path")
  status       String?   @default("PENDING") @map("status")
  retryCount   Int       @default(0) @map("retry_count")
  errorMessage String?   @map("error_message")
  createdAt    DateTime? @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")

  task CloneTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repo MyRepo    @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([repoId])
  @@index([status])
  @@map("my_repo_clone_task_item")
}

model DownloadTask {
  id                         Int    @id @default(autoincrement())
  status                     String?   @default("PENDING") @map("status") 
  targetDir                  String    @map("target_dir") 
  concurrency                Int       @default(5) @map("concurrency")
  /** 镜像源列表（JSON 数组，如 ["ghproxy","gh-proxy"]），按顺序回退 */
  mirrorSource              String?   @default("[\"direct\"]") @map("mirror_source") 
  extractArchive             Boolean   @default(false) @map("extract_archive") 
  deleteArchiveAfterExtract  Boolean   @default(false) @map("delete_archive_after_extract") 
  totalItems                 Int       @default(0) @map("total_items")
  completedItems             Int       @default(0) @map("completed_items")
  failedItems                Int       @default(0) @map("failed_items")
  totalBytes                 BigInt?      @default(0) @map("total_bytes")
  downloadedBytes            BigInt?      @default(0) @map("downloaded_bytes")
  createdAt                  DateTime? @map("created_at") 
  startedAt                  DateTime? @map("started_at") 
  finishedAt                 DateTime? @map("finished_at") 

  items       DownloadTaskItem[]
  myRepoItems MyRepoDownloadTaskItem[]

  @@index([status])
  @@index([createdAt])
  @@map("download_task")
}

// ── Agent 会话 ──

/**
 * AI Agent 会话表 —— 管理多轮对话。
 */
model AgentSession {
  id           String   @id @default(cuid())
  type         String   @default("auto") @map("type")
  sdkSessionId String?  @map("sdk_session_id")
  status       String   @default("active") @map("status")
  metadata     String?  @map("metadata")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  messages AgentMessage[]

  @@index([status])
  @@index([createdAt])
  @@map("agent_sessions")
}

/**
 * Agent 会话消息表 —— 存储消息历史。
 */
model AgentMessage {
  id        Int      @id @default(autoincrement())
  sessionId String   @map("session_id")
  role      String   @map("role")
  content   String   @map("content")
  createdAt DateTime @default(now()) @map("created_at")

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("agent_messages")
}

model DownloadTaskItem {
  id             Int    @id @default(autoincrement())
  taskId         Int    @map("task_id")
  repoId         Int    @map("repo_id")
  fullName       String?   @map("full_name") 
  archiveUrl     String?   @map("archive_url") 
  localFilePath  String?   @map("local_file_path") 
  extractDir     String?   @map("extract_dir") 
  fileSize       BigInt?      @default(0) @map("file_size")
  defaultBranch  String?   @map("default_branch") 
  status         String?   @default("PENDING") @map("status") 
  retryCount     Int       @default(0) @map("retry_count")
  errorMessage   String?   @map("error_message") 
  createdAt      DateTime? @map("created_at") 
  updatedAt      DateTime? @updatedAt @map("updated_at") 

  task DownloadTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repo GithubRepo   @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([repoId])
  @@index([status])
  @@map("download_task_item")
}

/**
 * 我的仓库下载任务子项 —— 与 download_task_item 平行，repoId 指向 my_repo。
 */
model MyRepoDownloadTaskItem {
  id             Int    @id @default(autoincrement())
  taskId         Int    @map("task_id")
  repoId         Int    @map("repo_id")
  fullName       String?   @map("full_name")
  archiveUrl     String?   @map("archive_url")
  localFilePath  String?   @map("local_file_path")
  extractDir     String?   @map("extract_dir")
  fileSize       BigInt?      @default(0) @map("file_size")
  defaultBranch  String?   @map("default_branch")
  status         String?   @default("PENDING") @map("status")
  retryCount     Int       @default(0) @map("retry_count")
  errorMessage   String?   @map("error_message")
  createdAt      DateTime? @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")

  task DownloadTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repo MyRepo       @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([repoId])
  @@index([status])
  @@map("my_repo_download_task_item")
}

// ── 学习收藏 ──

model LearnRecord {
  id         Int       @id @default(autoincrement())
  repoId     Int       @unique @map("repo_id")
  status     String    @default("WANT") @map("status")
  priority   String    @default("MEDIUM") @map("priority")
  notes      String?   @map("notes")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  repo     GithubRepo     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  tagLinks LearnTagLink[]

  @@index([status, priority])
  @@index([createdAt])
  @@map("learn_record")
}

model LearnTag {
  id        Int      @id @default(autoincrement())
  name      String   @unique @map("name")
  color     String?  @map("color")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tagLinks LearnTagLink[]

  @@map("learn_tag")
}

model LearnTagLink {
  id            Int      @id @default(autoincrement())
  learnRecordId Int      @map("learn_record_id")
  tagId         Int      @map("tag_id")
  createdAt     DateTime @default(now()) @map("created_at")

  learnRecord LearnRecord @relation(fields: [learnRecordId], references: [id], onDelete: Cascade)
  tag         LearnTag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([learnRecordId, tagId])
  @@index([tagId])
  @@map("learn_tag_link")
}
