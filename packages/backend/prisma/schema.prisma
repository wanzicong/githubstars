generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model GithubRepo {
  id              BigInt    @id @default(autoincrement())
  repoName        String?   @map("repo_name") @db.VarChar(255)
  fullName        String?   @unique @map("full_name") @db.VarChar(500)
  description     String?   @map("description") @db.Text
  descriptionCn   String?   @map("description_cn") @db.Text
  readmeCn        String?   @map("readme_cn") @db.LongText
  readmeOriginal  String?   @map("readme_original") @db.LongText
  readmeFetched   Boolean   @default(false) @map("readme_fetched") @db.TinyInt
  language        String?   @map("language") @db.VarChar(100)
  ownerName       String?   @map("owner_name") @db.VarChar(255)
  ownerAvatarUrl  String?   @map("owner_avatar_url") @db.VarChar(1000)
  htmlUrl         String?   @map("html_url") @db.VarChar(1000)
  homepage        String?   @map("homepage") @db.VarChar(1000)
  starsCount      Int       @default(0) @map("stars_count")
  forksCount      Int       @default(0) @map("forks_count")
  watchersCount   Int       @default(0) @map("watchers_count")
  openIssuesCount Int       @default(0) @map("open_issues_count")
  topics          String?   @map("topics") @db.Text
  licenseName     String?   @map("license_name") @db.VarChar(255)
  isFork          Boolean   @default(false) @map("is_fork") @db.TinyInt
  isArchived      Boolean   @default(false) @map("is_archived") @db.TinyInt
  repoCreatedAt   DateTime? @map("repo_created_at") @db.DateTime
  repoUpdatedAt   DateTime? @map("repo_updated_at") @db.DateTime
  repoPushedAt    DateTime? @map("repo_pushed_at") @db.DateTime
  starredAt       DateTime? @map("starred_at") @db.DateTime
  createdAt       DateTime  @map("created_at") @db.DateTime
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime

  // 关联
  translationItems TranslationTaskItem[]
  cloneItems       CloneTaskItem[]
  categories       CategoryRepoLink[]

  @@index([language])
  @@index([ownerName])
  @@index([starredAt])
  @@index([starsCount])
  @@index([repoUpdatedAt])
  @@map("github_repo")
}

// ── 分类管理 ──

/**
 * 分类表 —— 两级分类自引用结构。
 *
 * 一级分类 parentId = null，二级分类 parentId 指向一级分类的 id。
 * 使用 onDelete: Cascade 确保删除父分类时自动删除所有子分类。
 */
model Category {
  id          BigInt   @id @default(autoincrement())
  name        String   @map("name") @db.VarChar(100)
  parentId    BigInt?  @map("parent_id")
  sortOrder   Int      @default(0) @map("sort_order")
  icon        String?  @map("icon") @db.VarChar(100)
  description String?  @map("description") @db.Text
  createdAt   DateTime @map("created_at") @db.DateTime
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime

  parent            Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          Category[]         @relation("CategoryTree")
  categoryRepoLinks CategoryRepoLink[]

  @@index([parentId])
  @@index([sortOrder])
  @@map("category")
}

/**
 * 分类-仓库关联中间表 —— 多对多关系。
 *
 * 一个仓库可属于多个分类，一个分类可包含多个仓库。
 * @@unique([categoryId, repoId]) 防止重复关联。
 */
model CategoryRepoLink {
  id         BigInt   @id @default(autoincrement())
  categoryId BigInt   @map("category_id")
  repoId     BigInt   @map("repo_id")
  createdAt  DateTime @map("created_at") @db.DateTime

  category Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  repo     GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([categoryId, repoId])
  @@index([repoId])
  @@map("category_repo_link")
}

model SyncLog {
  id           BigInt    @id @default(autoincrement())
  syncType     String?   @map("sync_type") @db.VarChar(50)
  status       String?   @map("status") @db.VarChar(50)
  totalCount   Int?      @map("total_count")
  syncedCount  Int?      @map("synced_count")
  startedAt    DateTime? @map("started_at") @db.DateTime
  finishedAt   DateTime? @map("finished_at") @db.DateTime
  errorMessage String?   @map("error_message") @db.Text
  createdAt    DateTime? @map("created_at") @db.DateTime

  @@index([status])
  @@index([createdAt])
  @@map("sync_log")
}

model SystemConfig {
  id          BigInt    @id @default(autoincrement())
  configKey   String    @unique @map("config_key") @db.VarChar(255)
  configValue String?   @map("config_value") @db.Text
  description String?   @map("description") @db.VarChar(500)
  createdAt   DateTime? @map("created_at") @db.DateTime
  updatedAt   DateTime? @map("updated_at") @db.DateTime

  @@map("system_config")
}

model TranslationTask {
  id              BigInt    @id @default(autoincrement())
  status          String?   @default("PENDING") @map("status") @db.VarChar(50)
  totalItems      Int       @default(0) @map("total_items")
  completedItems  Int       @default(0) @map("completed_items")
  failedItems     Int       @default(0) @map("failed_items")
  descTotal       Int       @default(0) @map("desc_total")
  descCompleted   Int       @default(0) @map("desc_completed")
  descFailed      Int       @default(0) @map("desc_failed")
  readmeTotal     Int       @default(0) @map("readme_total")
  readmeCompleted Int       @default(0) @map("readme_completed")
  readmeFailed    Int       @default(0) @map("readme_failed")
  createdAt       DateTime? @map("created_at") @db.DateTime
  finishedAt      DateTime? @map("finished_at") @db.DateTime

  items TranslationTaskItem[]

  @@map("translation_task")
}

model TranslationTaskItem {
  id            BigInt    @id @default(autoincrement())
  taskId        BigInt    @map("task_id")
  repoId        BigInt    @map("repo_id")
  fullName      String?   @map("full_name") @db.VarChar(500)
  translateType String    @map("translate_type") @db.VarChar(20)
  status        String?   @default("PENDING") @map("status") @db.VarChar(50)
  retryCount    Int       @default(0) @map("retry_count")
  errorMessage  String?   @map("error_message") @db.Text
  createdAt     DateTime? @map("created_at") @db.DateTime
  updatedAt     DateTime? @map("updated_at") @db.DateTime

  task TranslationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repo GithubRepo      @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([repoId])
  @@index([status])
  @@map("translation_task_item")
}

model CloneTask {
  id             BigInt    @id @default(autoincrement())
  status         String?   @default("PENDING") @map("status") @db.VarChar(50)
  targetDir      String    @map("target_dir") @db.VarChar(1000)
  concurrency    Int       @default(5) @map("concurrency")
  shallow        Boolean   @default(true) @map("shallow") @db.TinyInt
  totalItems     Int       @default(0) @map("total_items")
  completedItems Int       @default(0) @map("completed_items")
  failedItems    Int       @default(0) @map("failed_items")
  skippedItems   Int       @default(0) @map("skipped_items")
  createdAt      DateTime? @map("created_at") @db.DateTime
  startedAt      DateTime? @map("started_at") @db.DateTime
  finishedAt     DateTime? @map("finished_at") @db.DateTime

  items CloneTaskItem[]

  @@index([status])
  @@index([createdAt])
  @@map("clone_task")
}

model CloneTaskItem {
  id           BigInt    @id @default(autoincrement())
  taskId       BigInt    @map("task_id")
  repoId       BigInt    @map("repo_id")
  fullName     String?   @map("full_name") @db.VarChar(500)
  cloneUrl     String?   @map("clone_url") @db.VarChar(1000)
  localPath    String?   @map("local_path") @db.VarChar(1000)
  status       String?   @default("PENDING") @map("status") @db.VarChar(50)
  retryCount   Int       @default(0) @map("retry_count")
  errorMessage String?   @map("error_message") @db.Text
  createdAt    DateTime? @map("created_at") @db.DateTime
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.DateTime

  task CloneTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repo GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([repoId])
  @@index([status])
  @@map("clone_task_item")
}

// ════════════════════════════════════════════════
// 智能体底座 (Agent Platform) — 新增表
// ════════════════════════════════════════════════

/**
 * Agent 会话表。
 *
 * 存储每次 Agent 对话的上下文信息，包括系统提示词、
 * 使用的模型、token 用量估算和上下文窗口配置。
 *
 * @callers
 *   - AgentController.createSession() — 用户发起新对话
 *   - SessionManagerService — 会话生命周期管理
 *
 * @depends
 *   - agent_message 表 — 一对多消息记录
 *   - agent_task 表 — 一对多任务记录
 */
model AgentSession {
  id            BigInt    @id @default(autoincrement())
  title         String?   @map("title") @db.VarChar(255)
  status        String    @default("ACTIVE") @map("status") @db.VarChar(30)
  model         String?   @map("model") @db.VarChar(100)
  systemPrompt  String?   @map("system_prompt") @db.Text
  contextWindow Int       @default(100000) @map("context_window")
  tokenUsed     Int       @default(0) @map("token_used")
  messageCount  Int       @default(0) @map("message_count")
  createdAt     DateTime  @map("created_at") @db.DateTime
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime

  messages      AgentMessage[]
  tasks         AgentTask[]

  @@index([status])
  @@index([createdAt])
  @@map("agent_session")
}

/**
 * Agent 消息表。
 *
 * 持久化每次对话中的用户消息和 Agent 回复，
 * 支持工具调用关联和 token 统计。
 *
 * @callers
 *   - SessionManagerService — 消息追加和查询
 *
 * @depends
 *   - agent_session 表 — 多对一关联到会话
 */
model AgentMessage {
  id          BigInt    @id @default(autoincrement())
  sessionId   BigInt    @map("session_id")
  role        String    @map("role") @db.VarChar(20)
  content     String    @map("content") @db.LongText
  toolCallId  String?   @map("tool_call_id") @db.VarChar(255)
  tokenCount  Int?      @map("token_count")
  metadata    Json?     @map("metadata")
  createdAt   DateTime  @map("created_at") @db.DateTime

  session     AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("agent_message")
}

/**
 * Agent 任务表 —— 异步任务主表。
 *
 * 支持 CHAT（对话）、ANALYSIS（分析）、TRANSLATE（翻译）、
 * CLASSIFY（分类）、EXPORT（导出）等多种任务类型。
 * 状态流转: PENDING → QUEUED → RUNNING → COMPLETED | FAILED | CANCELLED
 * 审批分支: RUNNING → WAITING_APPROVAL → APPROVED/DENIED → RUNNING
 *
 * @callers
 *   - AgentController.createTask() — 用户创建异步任务
 *   - AgentQueueProcessor — BullMQ Worker 消费执行
 *   - OrchestratorService — 任务生命周期管理
 *
 * @depends
 *   - agent_session 表 — 可选关联会话
 *   - tool_invocation 表 — 一对多工具调用记录
 *   - agent_approval 表 — 一对多审批记录
 */
model AgentTask {
  id             BigInt    @id @default(autoincrement())
  sessionId      BigInt?   @map("session_id")
  type           String    @map("type") @db.VarChar(50)
  status         String    @default("PENDING") @map("status") @db.VarChar(30)
  priority       Int       @default(0) @map("priority")
  input          Json      @map("input")
  output         Json?     @map("output")
  errorMsg       String?   @map("error_msg") @db.Text
  progress       String?   @map("progress") @db.VarChar(255)
  progressPct    Int       @default(0) @map("progress_pct")
  totalSteps     Int       @default(0) @map("total_steps")
  completedSteps Int       @default(0) @map("completed_steps")
  createdAt      DateTime  @map("created_at") @db.DateTime
  startedAt      DateTime? @map("started_at") @db.DateTime
  finishedAt     DateTime? @map("finished_at") @db.DateTime
  expiresAt      DateTime? @map("expires_at") @db.DateTime

  session        AgentSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  invocations    ToolInvocation[]
  approvalLogs   AgentApproval[]

  @@index([sessionId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("agent_task")
}

/**
 * 工具调用记录表。
 *
 * 每条记录对应一次 Agent 工具调用，记录工具名称、
 * 调用参数、返回结果、耗时和状态。
 *
 * @callers
 *   - AgentExecutorService — handleOnToolUse / handleOnToolResult hooks
 *   - ToolInvokerService — 工具执行结果记录
 *
 * @depends
 *   - agent_task 表 — 多对一关联到任务
 */
model ToolInvocation {
  id          BigInt    @id @default(autoincrement())
  taskId      BigInt    @map("task_id")
  toolName    String    @map("tool_name") @db.VarChar(255)
  toolType    String    @map("tool_type") @db.VarChar(20)
  input       Json      @map("input")
  output      Json?     @map("output")
  status      String    @default("PENDING") @map("status") @db.VarChar(20)
  durationMs  Int?      @map("duration_ms")
  errorMsg    String?   @map("error_msg") @db.Text
  createdAt   DateTime  @map("created_at") @db.DateTime

  task        AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([toolName])
  @@index([createdAt])
  @@map("tool_invocation")
}

/**
 * MCP 服务器注册表。
 *
 * 管理 MCP (Model Context Protocol) 服务器的注册信息，
 * 支持 stdio 和 HTTP 两种传输方式。
 *
 * @callers
 *   - McpAdapterService — 加载和管理 MCP 服务器连接
 *   - AgentController.registerMcpServer() — 注册 API
 *
 * @depends
 *   - 无外部表依赖（独立配置表）
 */
model AgentMcpServer {
  id          BigInt    @id @default(autoincrement())
  name        String    @unique @map("name") @db.VarChar(255)
  transport   String    @map("transport") @db.VarChar(20)
  config      Json      @map("config")
  status      String    @default("DISABLED") @map("status") @db.VarChar(20)
  toolCount   Int       @default(0) @map("tool_count")
  lastCheckAt DateTime? @map("last_check_at") @db.DateTime
  createdAt   DateTime  @map("created_at") @db.DateTime
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime

  @@map("agent_mcp_server")
}

/**
 * 审计日志表。
 *
 * 记录所有 Agent 操作的关键事件，包括任务创建、工具调用、
 * Prompt 阻断和权限拒绝等安全相关事件。
 *
 * @callers
 *   - AgentExecutorService — 各 hooks 中写入审计日志
 *   - PromptSanitizerPipe — Prompt 注入阻断记录
 *   - AgentPermissionGuard — 权限拒绝记录
 */
model AgentAuditLog {
  id          BigInt    @id @default(autoincrement())
  taskId      BigInt?   @map("task_id")
  sessionId   BigInt?   @map("session_id")
  action      String    @map("action") @db.VarChar(100)
  actor       String?   @map("actor") @db.VarChar(255)
  detail      String?   @map("detail") @db.Text
  meta        Json?     @map("meta")
  createdAt   DateTime  @map("created_at") @db.DateTime

  @@index([taskId])
  @@index([sessionId])
  @@index([action])
  @@index([createdAt])
  @@map("agent_audit_log")
}

/**
 * 审批记录表 (Human-in-the-loop)。
 *
 * 当 Agent 尝试调用高风险工具时创建审批记录，
 * 前端通过 SSE 收到通知后弹窗请示用户确认或拒绝。
 *
 * @callers
 *   - AgentExecutorService.createApprovalRequest() — canUseTool 返回 ask 时创建
 *   - AgentController.approveTask() / denyTask() — 用户审批操作
 *
 * @depends
 *   - agent_task 表 — 多对一关联到任务
 */
model AgentApproval {
  id          BigInt    @id @default(autoincrement())
  taskId      BigInt    @map("task_id")
  stepId      String    @map("step_id") @db.VarChar(255)
  toolName    String    @map("tool_name") @db.VarChar(255)
  description String    @map("description") @db.Text
  input       Json      @map("input")
  status      String    @default("PENDING") @map("status") @db.VarChar(20)
  approvedBy  String?   @map("approved_by") @db.VarChar(255)
  approvedAt  DateTime? @map("approved_at") @db.DateTime
  createdAt   DateTime  @map("created_at") @db.DateTime

  task        AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([status])
  @@map("agent_approval")
}
