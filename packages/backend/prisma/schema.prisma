generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model GithubRepo {
  id              BigInt    @id @default(autoincrement())
  repoName        String?   @map("repo_name") @db.VarChar(255)
  fullName        String?   @unique @map("full_name") @db.VarChar(500)
  description     String?   @map("description") @db.Text
  descriptionCn   String?   @map("description_cn") @db.Text
  readmeCn        String?   @map("readme_cn") @db.LongText
  readmeOriginal  String?   @map("readme_original") @db.LongText
  readmeFetched   Boolean   @default(false) @map("readme_fetched") @db.TinyInt
  language        String?   @map("language") @db.VarChar(100)
  ownerName       String?   @map("owner_name") @db.VarChar(255)
  ownerAvatarUrl  String?   @map("owner_avatar_url") @db.VarChar(1000)
  htmlUrl         String?   @map("html_url") @db.VarChar(1000)
  homepage        String?   @map("homepage") @db.VarChar(1000)
  starsCount      Int       @default(0) @map("stars_count")
  forksCount      Int       @default(0) @map("forks_count")
  watchersCount   Int       @default(0) @map("watchers_count")
  openIssuesCount Int       @default(0) @map("open_issues_count")
  topics          String?   @map("topics") @db.Text
  licenseName     String?   @map("license_name") @db.VarChar(255)
  isFork          Boolean   @default(false) @map("is_fork") @db.TinyInt
  isArchived      Boolean   @default(false) @map("is_archived") @db.TinyInt
  repoSize        Int?      @map("repo_size")
  defaultBranch   String?   @map("default_branch") @db.VarChar(255)
  visibility      String?   @map("visibility") @db.VarChar(50)
  repoCreatedAt   DateTime? @map("repo_created_at") @db.DateTime
  repoUpdatedAt   DateTime? @map("repo_updated_at") @db.DateTime
  repoPushedAt    DateTime? @map("repo_pushed_at") @db.DateTime
  starredAt       DateTime? @map("starred_at") @db.DateTime
  createdAt       DateTime  @map("created_at") @db.DateTime
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime

  // 关联
  cloneItems       CloneTaskItem[]
  downloadItems    DownloadTaskItem[]
  categories       CategoryRepoLink[]
  learnRecord      LearnRecord?

  @@index([language])
  @@index([ownerName])
  @@index([starredAt])
  @@index([starsCount])
  @@index([repoUpdatedAt])
  @@map("github_repo")
}

// ── 分类管理 ──

/**
 * 分类表 —— 两级分类自引用结构。
 *
 * 一级分类 parentId = null，二级分类 parentId 指向一级分类的 id。
 * 使用 onDelete: Cascade 确保删除父分类时自动删除所有子分类。
 */
model Category {
  id          BigInt   @id @default(autoincrement())
  name        String   @map("name") @db.VarChar(100)
  parentId    BigInt?  @map("parent_id")
  sortOrder   Int      @default(0) @map("sort_order")
  icon        String?  @map("icon") @db.VarChar(100)
  description String?  @map("description") @db.Text
  createdAt   DateTime @map("created_at") @db.DateTime
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime

  parent            Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          Category[]         @relation("CategoryTree")
  categoryRepoLinks CategoryRepoLink[]
  myRepoLinks       MyRepoCategoryLink[]

  @@index([parentId])
  @@index([sortOrder])
  @@map("category")
}

/**
 * 分类-仓库关联中间表 —— 多对多关系。
 *
 * 一个仓库可属于多个分类，一个分类可包含多个仓库。
 * @@unique([categoryId, repoId]) 防止重复关联。
 */
model CategoryRepoLink {
  id         BigInt   @id @default(autoincrement())
  categoryId BigInt   @map("category_id")
  repoId     BigInt   @map("repo_id")
  createdAt  DateTime @map("created_at") @db.DateTime

  category Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  repo     GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([categoryId, repoId])
  @@index([repoId])
  @@map("category_repo_link")
}

// ── 我的仓库 ──

/**
 * 我的仓库表 —— 用户自己在 GitHub 上创建的仓库（含私有）。
 *
 * 与 github_repo（Star 收藏）独立建表：
 * - 无 starredAt，多 isPrivate
 * - fullName 唯一，同步时 UPSERT 增量更新，不做删除同步
 */
model MyRepo {
  id              BigInt    @id @default(autoincrement())
  repoName        String?   @map("repo_name") @db.VarChar(255)
  fullName        String?   @unique @map("full_name") @db.VarChar(500)
  description     String?   @map("description") @db.Text
  descriptionCn   String?   @map("description_cn") @db.Text
  readmeCn        String?   @map("readme_cn") @db.LongText
  readmeOriginal  String?   @map("readme_original") @db.LongText
  readmeFetched   Boolean   @default(false) @map("readme_fetched") @db.TinyInt
  language        String?   @map("language") @db.VarChar(100)
  ownerName       String?   @map("owner_name") @db.VarChar(255)
  ownerAvatarUrl  String?   @map("owner_avatar_url") @db.VarChar(1000)
  htmlUrl         String?   @map("html_url") @db.VarChar(1000)
  homepage        String?   @map("homepage") @db.VarChar(1000)
  starsCount      Int       @default(0) @map("stars_count")
  forksCount      Int       @default(0) @map("forks_count")
  watchersCount   Int       @default(0) @map("watchers_count")
  openIssuesCount Int       @default(0) @map("open_issues_count")
  topics          String?   @map("topics") @db.Text
  licenseName     String?   @map("license_name") @db.VarChar(255)
  isFork          Boolean   @default(false) @map("is_fork") @db.TinyInt
  isArchived      Boolean   @default(false) @map("is_archived") @db.TinyInt
  isPrivate       Boolean   @default(false) @map("is_private") @db.TinyInt
  repoSize        Int?      @map("repo_size")
  defaultBranch   String?   @map("default_branch") @db.VarChar(255)
  visibility      String?   @map("visibility") @db.VarChar(50)
  repoCreatedAt   DateTime? @map("repo_created_at") @db.DateTime
  repoUpdatedAt   DateTime? @map("repo_updated_at") @db.DateTime
  repoPushedAt    DateTime? @map("repo_pushed_at") @db.DateTime
  createdAt       DateTime  @map("created_at") @db.DateTime
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime

  // 关联
  cloneItems    MyRepoCloneTaskItem[]
  downloadItems MyRepoDownloadTaskItem[]
  categories    MyRepoCategoryLink[]

  @@index([language])
  @@index([starsCount])
  @@index([repoUpdatedAt])
  @@index([isPrivate])
  @@map("my_repo")
}

/**
 * 我的仓库-分类关联表 —— 多对多关系。
 *
 * 复用 category 分类树，与 category_repo_link（Star 仓库）平行。
 */
model MyRepoCategoryLink {
  id         BigInt   @id @default(autoincrement())
  categoryId BigInt   @map("category_id")
  myRepoId   BigInt   @map("my_repo_id")
  createdAt  DateTime @map("created_at") @db.DateTime

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  myRepo   MyRepo   @relation(fields: [myRepoId], references: [id], onDelete: Cascade)

  @@unique([categoryId, myRepoId])
  @@index([myRepoId])
  @@map("my_repo_category_link")
}

model SyncLog {
  id           BigInt    @id @default(autoincrement())
  syncType     String?   @map("sync_type") @db.VarChar(50)
  status       String?   @map("status") @db.VarChar(50)
  totalCount   Int?      @map("total_count")
  syncedCount  Int?      @map("synced_count")
  startedAt    DateTime? @map("started_at") @db.DateTime
  finishedAt   DateTime? @map("finished_at") @db.DateTime
  errorMessage String?   @map("error_message") @db.Text
  createdAt    DateTime? @map("created_at") @db.DateTime

  @@index([status])
  @@index([createdAt])
  @@map("sync_log")
}

model SystemConfig {
  id          BigInt    @id @default(autoincrement())
  configKey   String    @unique @map("config_key") @db.VarChar(255)
  configValue String?   @map("config_value") @db.Text
  description String?   @map("description") @db.VarChar(500)
  createdAt   DateTime? @map("created_at") @db.DateTime
  updatedAt   DateTime? @map("updated_at") @db.DateTime

  @@map("system_config")
}

model CloneTask {
  id             BigInt    @id @default(autoincrement())
  status         String?   @default("PENDING") @map("status") @db.VarChar(50)
  targetDir      String    @map("target_dir") @db.VarChar(1000)
  concurrency    Int       @default(5) @map("concurrency")
  shallow        Boolean   @default(true) @map("shallow") @db.TinyInt
  mirrorSource   String?   @default("direct") @map("mirror_source") @db.VarChar(50)
  totalItems     Int       @default(0) @map("total_items")
  completedItems Int       @default(0) @map("completed_items")
  failedItems    Int       @default(0) @map("failed_items")
  skippedItems   Int       @default(0) @map("skipped_items")
  createdAt      DateTime? @map("created_at") @db.DateTime
  startedAt      DateTime? @map("started_at") @db.DateTime
  finishedAt     DateTime? @map("finished_at") @db.DateTime

  items       CloneTaskItem[]
  myRepoItems MyRepoCloneTaskItem[]

  @@index([status])
  @@index([createdAt])
  @@map("clone_task")
}

model CloneTaskItem {
  id           BigInt    @id @default(autoincrement())
  taskId       BigInt    @map("task_id")
  repoId       BigInt    @map("repo_id")
  fullName     String?   @map("full_name") @db.VarChar(500)
  cloneUrl     String?   @map("clone_url") @db.VarChar(1000)
  localPath    String?   @map("local_path") @db.VarChar(1000)
  status       String?   @default("PENDING") @map("status") @db.VarChar(50)
  retryCount   Int       @default(0) @map("retry_count")
  errorMessage String?   @map("error_message") @db.Text
  createdAt    DateTime? @map("created_at") @db.DateTime
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.DateTime

  task CloneTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repo GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([repoId])
  @@index([status])
  @@map("clone_task_item")
}

/**
 * 我的仓库克隆任务子项 —— 与 clone_task_item 平行，repoId 指向 my_repo。
 */
model MyRepoCloneTaskItem {
  id           BigInt    @id @default(autoincrement())
  taskId       BigInt    @map("task_id")
  repoId       BigInt    @map("repo_id")
  fullName     String?   @map("full_name") @db.VarChar(500)
  cloneUrl     String?   @map("clone_url") @db.VarChar(1000)
  localPath    String?   @map("local_path") @db.VarChar(1000)
  status       String?   @default("PENDING") @map("status") @db.VarChar(50)
  retryCount   Int       @default(0) @map("retry_count")
  errorMessage String?   @map("error_message") @db.Text
  createdAt    DateTime? @map("created_at") @db.DateTime
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.DateTime

  task CloneTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repo MyRepo    @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([repoId])
  @@index([status])
  @@map("my_repo_clone_task_item")
}

model DownloadTask {
  id                         BigInt    @id @default(autoincrement())
  status                     String?   @default("PENDING") @map("status") @db.VarChar(50)
  targetDir                  String    @map("target_dir") @db.VarChar(1000)
  concurrency                Int       @default(5) @map("concurrency")
  /** 镜像源列表（JSON 数组，如 ["ghproxy","gh-proxy"]），按顺序回退 */
  mirrorSource              String?   @default("[\"direct\"]") @map("mirror_source") @db.VarChar(500)
  extractArchive             Boolean   @default(false) @map("extract_archive") @db.TinyInt
  deleteArchiveAfterExtract  Boolean   @default(false) @map("delete_archive_after_extract") @db.TinyInt
  totalItems                 Int       @default(0) @map("total_items")
  completedItems             Int       @default(0) @map("completed_items")
  failedItems                Int       @default(0) @map("failed_items")
  totalBytes                 BigInt?   @default(0) @map("total_bytes")
  downloadedBytes            BigInt?   @default(0) @map("downloaded_bytes")
  createdAt                  DateTime? @map("created_at") @db.DateTime
  startedAt                  DateTime? @map("started_at") @db.DateTime
  finishedAt                 DateTime? @map("finished_at") @db.DateTime

  items       DownloadTaskItem[]
  myRepoItems MyRepoDownloadTaskItem[]

  @@index([status])
  @@index([createdAt])
  @@map("download_task")
}

// ── Agent 会话 ──

/**
 * AI Agent 会话表 —— 管理多轮对话。
 *
 * session.type: "none" | "auto" | "resume"
 * sdkSessionId: Claude SDK 内部会话 ID，用于 resume 恢复上下文
 */
model AgentSession {
  id           String   @id @default(cuid())
  type         String   @default("auto") @map("type") @db.VarChar(20)
  sdkSessionId String?  @map("sdk_session_id") @db.VarChar(255)
  status       String   @default("active") @map("status") @db.VarChar(20)
  metadata     Json?    @map("metadata") @db.Json
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  messages AgentMessage[]

  @@index([status])
  @@index([createdAt])
  @@map("agent_sessions")
}

/**
 * Agent 会话消息表 —— 存储消息历史。
 */
model AgentMessage {
  id        Int      @id @default(autoincrement())
  sessionId String   @map("session_id")
  role      String   @map("role") @db.VarChar(20)
  content   Json     @map("content") @db.Json
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("agent_messages")
}

model DownloadTaskItem {
  id             BigInt    @id @default(autoincrement())
  taskId         BigInt    @map("task_id")
  repoId         BigInt    @map("repo_id")
  fullName       String?   @map("full_name") @db.VarChar(500)
  archiveUrl     String?   @map("archive_url") @db.VarChar(2000)
  localFilePath  String?   @map("local_file_path") @db.VarChar(1000)
  extractDir     String?   @map("extract_dir") @db.VarChar(1000)
  fileSize       BigInt?   @default(0) @map("file_size")
  defaultBranch  String?   @map("default_branch") @db.VarChar(100)
  status         String?   @default("PENDING") @map("status") @db.VarChar(50)
  retryCount     Int       @default(0) @map("retry_count")
  errorMessage   String?   @map("error_message") @db.Text
  createdAt      DateTime? @map("created_at") @db.DateTime
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.DateTime

  task DownloadTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repo GithubRepo   @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([repoId])
  @@index([status])
  @@map("download_task_item")
}

/**
 * 我的仓库下载任务子项 —— 与 download_task_item 平行，repoId 指向 my_repo。
 */
model MyRepoDownloadTaskItem {
  id             BigInt    @id @default(autoincrement())
  taskId         BigInt    @map("task_id")
  repoId         BigInt    @map("repo_id")
  fullName       String?   @map("full_name") @db.VarChar(500)
  archiveUrl     String?   @map("archive_url") @db.VarChar(2000)
  localFilePath  String?   @map("local_file_path") @db.VarChar(1000)
  extractDir     String?   @map("extract_dir") @db.VarChar(1000)
  fileSize       BigInt?   @default(0) @map("file_size")
  defaultBranch  String?   @map("default_branch") @db.VarChar(100)
  status         String?   @default("PENDING") @map("status") @db.VarChar(50)
  retryCount     Int       @default(0) @map("retry_count")
  errorMessage   String?   @map("error_message") @db.Text
  createdAt      DateTime? @map("created_at") @db.DateTime
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.DateTime

  task DownloadTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repo MyRepo       @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([repoId])
  @@index([status])
  @@map("my_repo_download_task_item")
}

// ── 学习收藏 ──

/**
 * 学习记录 —— 一个 repo 对应一条学习记录（1:1）。
 *
 * 用户从已 star 的 github_repo 中挑选想要学习的项目，
 * 记录学习状态、优先级、个人笔记和时间戳。
 *
 * 状态取值（String 而非 enum，与项目现有惯例一致）：
 * - WANT      想学（默认）
 * - LEARNING  在学
 * - DONE      已学完
 * - SHELVED   搁置
 *
 * 优先级取值：
 * - LOW / MEDIUM / HIGH
 *
 * 时间戳语义：
 * - startedAt  状态首次变为 LEARNING 时写入
 * - finishedAt 状态首次变为 DONE 时写入
 * - 状态回到 WANT 时，两个时间戳清空
 */
model LearnRecord {
  id         BigInt    @id @default(autoincrement())
  repoId     BigInt    @unique @map("repo_id")
  status     String    @default("WANT") @map("status") @db.VarChar(20)
  priority   String    @default("MEDIUM") @map("priority") @db.VarChar(20)
  notes      String?   @map("notes") @db.Text
  startedAt  DateTime? @map("started_at") @db.DateTime
  finishedAt DateTime? @map("finished_at") @db.DateTime
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime

  repo     GithubRepo     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  tagLinks LearnTagLink[]

  @@index([status, priority])
  @@index([createdAt])
  @@map("learn_record")
}

/**
 * 学习标签 —— 平铺的用户自定义标签（无层级，与 category 树形分类互补）。
 *
 * 一个 LearnRecord 可挂多个标签；同一标签可被多个 LearnRecord 使用。
 */
model LearnTag {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @map("name") @db.VarChar(50)
  color     String?  @map("color") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime

  tagLinks LearnTagLink[]

  @@map("learn_tag")
}

/**
 * 学习记录-标签关联 —— 多对多中间表。
 *
 * 模式与 category_repo_link 一致：独立主键 + @@unique 防重 + 两端级联删除。
 */
model LearnTagLink {
  id            BigInt   @id @default(autoincrement())
  learnRecordId BigInt   @map("learn_record_id")
  tagId         BigInt   @map("tag_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime

  learnRecord LearnRecord @relation(fields: [learnRecordId], references: [id], onDelete: Cascade)
  tag         LearnTag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([learnRecordId, tagId])
  @@index([tagId])
  @@map("learn_tag_link")
}
