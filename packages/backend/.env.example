# ============================================================
# GitHub Stars — 环境变量模板
# ============================================================
# 复制此文件为 .env（开发）或 .env.test（测试）并按需修改。

# 数据库连接（MySQL 8.x）
# 开发: mysql://root:123456@127.0.0.1:3307/githubstars?charset=utf8mb4
# 测试: mysql://root:123456@127.0.0.1:3307/githubstars_test?charset=utf8mb4
DATABASE_URL=""

# 后端服务端口（默认 10002）
PORT=10002

# CORS 允许的前端源（逗号分隔）
CORS_ORIGINS="http://localhost:10001"

# 日志级别: debug | info | error
LOG_LEVEL=info

# 环境标识: development | test | production
NODE_ENV=development
# MySQL 数据库连接（Prisma 需要此环境变量）
DATABASE_URL="mysql://root:YOUR_PASSWORD@127.0.0.1:3307/githubstars?charset=utf8mb4"

# 服务端口（可选，默认 3000）
PORT=3000

# ⚠️ GitHub Token、DeepSeek API Key 等业务配置不再通过 .env 管理
# 请在系统配置页面（前端 → 系统配置）中设置，数据保存在 system_config 表中
# 修改后立即生效，无需重启服务
