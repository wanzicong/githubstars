{
  "name": "@githubstars/backend",
  "version": "0.0.1",
  "description": "GitHub Stars NestJS 后端服务",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:unit": "jest --testPathPatterns='test/unit|src/.*\\.spec\\.ts'",
    "test:integration": "jest --config ./test/jest-e2e.json --testPathPatterns='test/integration'",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "db:test:up": "docker-compose -f ../../docker-compose.test.yml up -d",
    "db:test:down": "docker-compose -f ../../docker-compose.test.yml down -v",
    "db:test:push": "dotenv -e .env.test -- npx prisma db push --skip-generate",
    "db:test:reset": "dotenv -e .env.test -- npx prisma db push --force-reset --skip-generate",
    "db:test:setup": "npm run db:test:up && npx wait-on tcp:3308 && npm run db:test:push",
    "db:test:seed": "dotenv -e .env.test -- npx prisma db seed",
    "test:db": "jest --config ./test/jest-e2e.json --testPathPatterns='test/integration'",
    "test:cov": "jest --coverage --collectCoverageFrom='src/**/*.ts' --coveragePathIgnorePatterns='src/agent/|src/main.ts|src/prisma/prisma.service.ts'",
    "test:all": "npm run test:cov",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.177",
    "@githubstars/shared": "*",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.78.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mysql2": "^3.22.5",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "(src/.*\\.spec\\.ts|test/unit/.*\\.spec\\.ts)$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.service.ts",
      "src/common/utils/**/*.ts",
      "src/common/constants/**/*.ts"
    ],
    "coveragePathIgnorePatterns": [
      "node_modules",
      "test/",
      "src/agent/",
      "src/main.ts",
      "src/prisma/prisma.service.ts",
      "src/common/dto/"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 30,
        "functions": 50,
        "lines": 45,
        "statements": 45
      }
    },
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/test/setup-env.ts"
  }
}
