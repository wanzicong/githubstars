{
  "name": "@githubstars/github-agent",
  "version": "0.1.0",
  "description": "GitHub Stars AI Agent — 基于 Claude Agent SDK 的智能仓库浏览与搜索代理",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "http://localhost:4873/"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "build": "tsc -b",
    "prepublishOnly": "tsc -b",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.59",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^5.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "globals": "^16.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
