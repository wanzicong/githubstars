{
  "name": "@githubstars/mcp-server",
  "version": "1.0.0",
  "description": "GitHub Stars MCP Server — 将 GitHub Stars 后端 API 封装为 MCP 工具供外部 AI 调用",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "githubstars-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external",
    "build:plugin": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=../../plugins/githubstars-agent/server/index.cjs --minify --legal-comments=none",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:plugin && node --test test/plugin-package.test.mjs",
    "test:plugin:smoke": "node --test test/plugin-live-smoke.test.mjs",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.3",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.18.0",
    "globals": "^17.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
